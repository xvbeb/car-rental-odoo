<odoo>
    <record id="car_rental_booking_view_list" model="ir.ui.view">
        <field name="name">car.rental.booking.list</field>
        <field name="model">car.rental.booking</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="day_count"/>
                <field name="total_amount" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="car_rental_booking_view_form" model="ir.ui.view">
        <field name="name">car.rental.booking.form</field>
        <field name="model">car.rental.booking</field>
        <field name="arch" type="xml">
            <form string="Car Rental Booking">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,active,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="vehicle_id"/>
                            <field name="daily_rate"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="day_count" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="pickup_location_id"/>
                        <field name="return_location_id"/>
                    </group>
                    <notebook>
                        <page string="Inspections"><field name="inspection_ids" readonly="1"/></page>
                        <page string="Notes"><field name="notes" placeholder="Additional rental notes..."/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_booking_view_search" model="ir.ui.view">
        <field name="name">car.rental.booking.search</field>
        <field name="model">car.rental.booking</field>
        <field name="arch" type="xml">
            <search string="Search Bookings">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="pickup_location_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                <filter name="group_month" string="Pickup Month" context="{'group_by': 'date_from:month'}"/>
            </search>
        </field>
    </record>

    <record id="car_rental_booking_view_kanban" model="ir.ui.view">
        <field name="name">car.rental.booking.kanban</field>
        <field name="model">car.rental.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <strong class="fs-5"><field name="name"/></strong>
                        <div class="mt-2"><field name="customer_id"/></div>
                        <div><field name="vehicle_id"/></div>
                        <div class="text-muted mt-2">
                            <field name="date_from"/> — <field name="date_to"/>
                        </div>
                        <div class="mt-2 fw-bold"><field name="total_amount"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="car_rental_booking_view_graph" model="ir.ui.view">
        <field name="name">car.rental.booking.graph</field>
        <field name="model">car.rental.booking</field>
        <field name="arch" type="xml">
            <graph string="Rental Revenue" type="bar">
                <field name="date_from" interval="month"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="car_rental_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">car.rental.booking</field>
        <field name="view_mode">list,form,kanban,graph</field>
        <field name="search_view_id" ref="car_rental_booking_view_search"/>
    </record>
</odoo>
