<odoo>
    <record id="car_rental_vehicle_view_list" model="ir.ui.view">
        <field name="name">car.rental.vehicle.list</field>
        <field name="model">car.rental.vehicle</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'"
                  decoration-warning="state == 'reserved'"
                  decoration-info="state == 'rented'"
                  decoration-muted="state == 'maintenance' or not active">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <field name="daily_rate"/>
                <field name="odometer" optional="show"/>
                <field name="state"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="car_rental_vehicle_view_form" model="ir.ui.view">
        <field name="name">car.rental.vehicle.form</field>
        <field name="model">car.rental.vehicle</field>
        <field name="arch" type="xml">
            <form string="Rental Vehicle">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="license_plate"/>
                            <field name="vin"/>
                            <field name="category_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="daily_rate"/>
                            <field name="currency_id"/>
                            <field name="odometer"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bookings"><field name="booking_ids" readonly="1"/></page>
                        <page string="Inspections"><field name="inspection_ids" readonly="1"/></page>
                        <page string="Damages"><field name="damage_ids" readonly="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_vehicle_view_search" model="ir.ui.view">
        <field name="name">car.rental.vehicle.search</field>
        <field name="model">car.rental.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="maintenance" string="Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="car_rental_vehicle_view_kanban" model="ir.ui.view">
        <field name="name">car.rental.vehicle.kanban</field>
        <field name="model">car.rental.vehicle</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="image_1920"/>
                <field name="license_plate"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <field name="daily_rate"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <field name="image_1920" widget="image" class="rounded"/>
                            <div>
                                <strong class="fs-5"><field name="name"/></strong>
                                <div><field name="license_plate"/></div>
                                <div class="text-muted"><field name="category_id"/></div>
                                <div><field name="location_id"/></div>
                                <div class="mt-2"><field name="daily_rate"/> / day</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="car_rental_vehicle_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">car.rental.vehicle</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="car_rental_vehicle_view_search"/>
    </record>
</odoo>
