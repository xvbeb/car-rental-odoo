<odoo>
    <record id="car_rental_damage_view_list" model="ir.ui.view">
        <field name="name">car.rental.damage.list</field>
        <field name="model">car.rental.damage</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'major'"
                  decoration-warning="severity == 'medium'"
                  decoration-success="state == 'fixed'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="inspection_id" optional="show"/>
                <field name="detected_date"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="repair_cost" sum="Загальна вартість ремонту"/>
            </list>
        </field>
    </record>

    <record id="car_rental_damage_view_form" model="ir.ui.view">
        <field name="name">car.rental.damage.form</field>
        <field name="model">car.rental.damage</field>
        <field name="arch" type="xml">
            <form string="Пошкодження автомобіля">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="inspection_id"/>
                            <field name="detected_date"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="state"/>
                            <field name="repair_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_damage_action" model="ir.actions.act_window">
        <field name="name">Пошкодження</field>
        <field name="res_model">car.rental.damage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
