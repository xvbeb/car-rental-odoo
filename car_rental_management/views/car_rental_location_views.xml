<odoo>
    <record id="car_rental_location_view_list" model="ir.ui.view">
        <field name="name">car.rental.location.list</field>
        <field name="model">car.rental.location</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="car_rental_location_view_form" model="ir.ui.view">
        <field name="name">car.rental.location.form</field>
        <field name="model">car.rental.location</field>
        <field name="arch" type="xml">
            <form string="Пункт прокату">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <field name="vehicle_ids" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_location_action" model="ir.actions.act_window">
        <field name="name">Пункти прокату</field>
        <field name="res_model">car.rental.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
