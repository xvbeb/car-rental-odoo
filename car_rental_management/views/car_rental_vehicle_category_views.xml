<odoo>
    <record id="car_rental_vehicle_category_view_list" model="ir.ui.view">
        <field name="name">car.rental.vehicle.category.list</field>
        <field name="model">car.rental.vehicle.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_daily_rate"/>
                <field name="deposit_amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="car_rental_vehicle_category_view_form" model="ir.ui.view">
        <field name="name">car.rental.vehicle.category.form</field>
        <field name="model">car.rental.vehicle.category</field>
        <field name="arch" type="xml">
            <form string="Категорія автомобіля">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_daily_rate"/>
                            <field name="deposit_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <field name="vehicle_ids" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_vehicle_category_action" model="ir.actions.act_window">
        <field name="name">Категорії автомобілів</field>
        <field name="res_model">car.rental.vehicle.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
